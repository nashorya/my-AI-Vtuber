<UserControl x:Class="AIVTuber.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same pastel ground, glass card, tinted fields and sakura pills as the streamer web page
         (App/WebUi/wwwroot/streamer.css), so signing in and the console read as one product. -->

    <Grid Background="#F6F0FF" ClipToBounds="True">
        <!-- Soft pastel lights behind the glass card. -->
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-220,-240,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#BFFFB3D6" Offset="0" />
                    <GradientStop Color="#00FFB3D6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="580" Height="580" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-220,-120,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#CCC7B8FF" Offset="0" />
                    <GradientStop Color="#00C7B8FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="720" Height="520" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-280" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#BFA9E2FF" Offset="0" />
                    <GradientStop Color="#00A9E2FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Width="420" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Shadow lives on its own layer so the card's text stays crisp. -->
                <Border CornerRadius="28" Background="#F6F0FF">
                    <Border.Effect>
                        <DropShadowEffect Color="#6E46AA" Opacity="0.18" BlurRadius="36" ShadowDepth="10" Direction="270" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="28" BorderThickness="1" Padding="30,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Color="#F2FFFFFF" Offset="0" />
                            <GradientStop Color="#D9FFF7FB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#80FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF8DC0" Offset="0" />
                                        <GradientStop Color="#9B8CFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="AIVTuber 陪播" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource StreamerInkBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="欢迎回来" Margin="0,22,0,0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource StreamerInkBrush}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource StreamerMuteBrush}"
                                       Text="登录后开始 AI 陪播。" />

                            <TextBlock Text="账号" Margin="0,22,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <TextBox x:Name="UsernameBox" Style="{StaticResource StreamerTextBox}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="账号" />

                            <TextBlock Text="密码" Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource StreamerPasswordBox}"
                                         KeyDown="OnPasswordKeyDown" AutomationProperties.Name="密码" />

                            <TextBlock Text="{Binding ErrorText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"
                                       Foreground="#B3263E" />

                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="LoginButton" Content="登录" Style="{StaticResource StreamerPrimaryButton}"
                                        Click="OnLogin" AutomationProperties.Name="登录" />
                                <Button Content="先看看设备和帮助" Style="{StaticResource StreamerGlassButton}" Margin="10,0,0,0"
                                        Click="OnDismiss"
                                        ToolTip="未登录时可以检查麦克风和查看帮助，但不会连接任何云端服务"
                                        AutomationProperties.Name="先看看设备和帮助" />
                            </WrapPanel>

                            <Button x:Name="ShowRegisterButton" Content="没有账号？用邀请码注册" Style="{StaticResource StreamerLinkButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnToggleRegister"
                                    AutomationProperties.Name="用邀请码注册" />
                        </StackPanel>

                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Text="注册账号" Margin="0,22,0,0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource StreamerInkBrush}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource StreamerMuteBrush}"
                                       Text="输入发放者给你的邀请码，再起一个账号名和密码。" />

                            <TextBlock Text="邀请码" Margin="0,22,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <TextBox x:Name="InviteBox" Style="{StaticResource StreamerTextBox}" CharacterCasing="Upper"
                                     AutomationProperties.Name="邀请码" />

                            <TextBlock Text="账号名" Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <TextBox x:Name="RegUsernameBox" Style="{StaticResource StreamerTextBox}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="3 到 20 位，只能用字母、数字、下划线和横线"
                                     AutomationProperties.Name="账号名" />

                            <TextBlock Text="密码（至少 8 位）" Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <PasswordBox x:Name="RegPasswordInput" Style="{StaticResource StreamerPasswordBox}"
                                         AutomationProperties.Name="密码" />

                            <TextBlock Text="再输一次密码" Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource StreamerMuteBrush}" />
                            <PasswordBox x:Name="RegConfirmInput" Style="{StaticResource StreamerPasswordBox}"
                                         KeyDown="OnConfirmKeyDown" AutomationProperties.Name="再输一次密码" />

                            <TextBlock Text="{Binding ErrorText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"
                                       Foreground="#B3263E" />

                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="RegisterButton" Content="注册并登录" Style="{StaticResource StreamerPrimaryButton}"
                                        Click="OnRegister" AutomationProperties.Name="注册并登录" />
                                <Button Content="先看看设备和帮助" Style="{StaticResource StreamerGlassButton}" Margin="10,0,0,0"
                                        Click="OnDismiss" AutomationProperties.Name="先看看设备和帮助" />
                            </WrapPanel>

                            <Button Content="已有账号？去登录" Style="{StaticResource StreamerLinkButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnToggleRegister"
                                    AutomationProperties.Name="去登录" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource StreamerMuteBrush}"
                                   Text="服务与隐私：陪播时的语音和文字会发送给安装包里配置的云端 AI 服务处理；登录服务只核对账号和有效期。" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
