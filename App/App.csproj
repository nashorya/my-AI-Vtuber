<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AIVTuber</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIVTuber</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Do NOT set IncludeAllContentForSelfExtract: it bundles CopyToPublishDirectory
         content into the exe and leaves publish/ without sidecar/config/assets, which
         breaks the Windows quality gate. AppPaths resolves content next to the .exe. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIVTuber.Core\AIVTuber.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.1.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Pinned explicitly because the SDK otherwise derives this from whatever .NET runtime
         patch happens to be installed. CI's runner image ships a newer runtime than the
         pinned 10.0.300 SDK, which flipped the requested version to 10.0.10 and broke
         locked-mode restore. Bumping the lock file each time only defers the next break. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.9" />
  </ItemGroup>

  <!-- WebRtcVadSharp is referenced by Core; native DLL does not flow through ProjectReference
       publish reliably for single-file apps. Copy via package path property + fail loud. -->
  <ItemGroup>
    <PackageReference Include="WebRtcVadSharp" Version="1.1.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgWebRtcVadSharp)' != ''">
    <None Include="$(PkgWebRtcVadSharp)\build\x64\WebRtcVad.dll"
          Link="WebRtcVad.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Check OutDir/PublishDir separately: RID projects often define PublishDir even on
       plain Build, and the old AfterTargets copy preferred PublishDir — leaving OutDir
       (where the exe actually runs) without WebRtcVad.dll. -->
  <Target Name="BuildDanmakuBridge" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_GoExe Condition="Exists('C:\Program Files\Go\bin\go.exe')">C:\Program Files\Go\bin\go.exe</_GoExe>
      <_GoExe Condition="'$(_GoExe)' == ''">go</_GoExe>
    </PropertyGroup>
    <Exec Command="set GOPROXY=https://goproxy.cn,direct&amp;&amp; set GOSUMDB=sum.golang.org&amp;&amp; &quot;$(_GoExe)&quot; build -ldflags &quot;-s -w&quot; -o danmaku_bridge.exe ."
          WorkingDirectory="$(MSBuildThisFileDirectory)..\danmaku-bridge"
          IgnoreExitCode="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\danmaku-bridge\go.mod')" />
  </Target>

  <Target Name="EnsureWebRtcVadNative" AfterTargets="Build">
    <Error Condition="!Exists('$(OutDir)WebRtcVad.dll')"
           Text="WebRtcVad.dll missing from $(OutDir). WebRtcVadSharp native asset failed to copy." />
  </Target>
  <Target Name="EnsureWebRtcVadNativePublished" AfterTargets="Publish">
    <Error Condition="'$(PublishDir)' != '' AND !Exists('$(PublishDir)WebRtcVad.dll')"
           Text="WebRtcVad.dll missing from $(PublishDir). WebRtcVadSharp native asset failed to publish." />
  </Target>

  <ItemGroup>
    <None Include="..\config.json.template" Link="config.json.template" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\danmaku_bridge.py" Link="danmaku_bridge.py" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\danmaku-bridge\danmaku_bridge.exe"
          Condition="Exists('..\danmaku-bridge\danmaku_bridge.exe')"
          Link="danmaku_bridge.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\README.txt" Link="README.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\asr_server.py" Link="sidecar\asr_server.py" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\sidecar\asr-sidecar.manifest.json" Link="sidecar\asr-sidecar.manifest.json" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\sidecar\requirements.lock" Link="sidecar\requirements.lock" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\scripts\Test-SidecarPackage.ps1" Link="scripts\Test-SidecarPackage.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\scripts\Test-G005PublishContract.ps1" Link="scripts\Test-G005PublishContract.ps1" CopyToPublishDirectory="PreserveNewest" />
    <!-- PNG avatar pack: sprites, poses, stickers, placeholder sheets, avatar.json.
         layered/ is the abandoned head-rotation approach (avatar.json marks it
         enabled:false and deprecated; the renderer goes through poses/), and
         contact_sheet.png is an authoring aid for verifying expression labels by eye.
         Both stay in the repo for reference but are 22MB of dead weight in a build. -->
    <None Include="..\assets\avatar\**\*"
          Exclude="..\assets\avatar\layered\**\*;..\assets\avatar\contact_sheet.png"
          Link="assets\avatar\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- WebView2 monitor UI (served via virtual host mapping). -->
    <None Include="WebUi\wwwroot\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
