<ui:FluentWindow x:Class="AIVTuber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:AIVTuber.App.Views"
        Title="AIVTuber 控制台"
        Height="680" Width="980"
        MinHeight="520" MinWidth="760"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="AIVTuber 控制台" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Distribution builds only: account state and logout (AUTH-02). -->
            <Border x:Name="AccountStrip" Grid.Row="0" Visibility="Collapsed" Padding="12,6"
                    Background="{DynamicResource AppSurfaceBrush}">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="AccountStatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <ui:Button x:Name="AccountActionButton" DockPanel.Dock="Right" Appearance="Secondary"
                               Click="OnAccountAction" AutomationProperties.Name="账号操作" />
                </DockPanel>
            </Border>

            <views:WebConsoleView x:Name="ConsoleHost" Grid.Row="1" />
            <views:FirstRunView x:Name="FirstRunHost" Grid.Row="1" Visibility="Collapsed" />
            <views:LoginView x:Name="LoginHost" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</ui:FluentWindow>
